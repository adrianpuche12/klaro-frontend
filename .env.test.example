# Variables para tests E2E con Playwright
# Copiar como .env.test y completar con credenciales reales

# URL base — por defecto usa producción
TEST_BASE_URL=https://app.belopia.app

# Credenciales admin (rol root o admin)
TEST_ADMIN_USER=root.admin
TEST_ADMIN_PASS=

# Credenciales user (rol user)
TEST_USER_USER=
TEST_USER_PASS=
