# Klaro Frontend — Variables de entorno
# Copiá este archivo como .env y completá los valores según el ambiente.
# Los valores EXPO_PUBLIC_* son visibles en el bundle del cliente — no poner secrets acá.

# URL base del backend API
EXPO_PUBLIC_API_URL=https://tu-backend.up.railway.app

# Keycloak — servidor de autenticación
EXPO_PUBLIC_KEYCLOAK_URL=https://keycloak.klaro.app
EXPO_PUBLIC_KEYCLOAK_REALM=klaro-dev
